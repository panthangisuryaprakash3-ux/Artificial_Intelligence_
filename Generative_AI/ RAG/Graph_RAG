def save_chat(messages):
    """
    Save chat messages as JSON.
    """

    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S_%f"
    )

    filename = f"chat_{timestamp}.json"

    filepath = os.path.join(
        CHAT_DIR,
        filename
    )

    with open(
        filepath,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            messages,
            file,
            ensure_ascii=False,
            indent=2
        )


def load_old_chats():
    """
    Load previously saved chats.
    """

    chats = {}

    for filename in os.listdir(CHAT_DIR):

        if not filename.endswith(".json"):
            continue

        filepath = os.path.join(
            CHAT_DIR,
            filename
        )

        try:

            with open(
                filepath,
                "r",
                encoding="utf-8"
            ) as file:

                chats[filename] = json.load(file)

        except Exception:
            continue

    return chats


def get_chat_headline(messages):
    """
    Get a short title from the first user message.
    """

    for message in messages:

        if message.get("role") == "user":

            text = message.get(
                "content",
                ""
            ).strip().replace("\n", " ")

            if len(text) > 45:
                return text[:45] + "..."

            return text

    return "New chat"


