                    "primary"
                    if is_active
                    else "secondary"
                )
            ):

                st.session_state.active_chat = filename
                st.session_state.messages = messages

                st.rerun()

    st.markdown("---")

    st.markdown("### 🔌 System Status")

    try:

        driver = get_neo4j_driver()

        st.success("Neo4j connected ✅")

    except Exception as error:

        st.error("Neo4j not connected ❌")
        st.caption(str(error))


# ============================================================
# 23. MAIN HEADER
# ============================================================

st.title("🧠 Chat with your PDF using Graph RAG")

st.subheader(
    "Upload PDFs → Build Knowledge Graph → Ask Questions"
)


# ============================================================
# 24. DISPLAY CHAT
# ============================================================

for message in st.session_state.messages:

    role = message.get("role")
    content = message.get("content", "")

    if role == "user":

        st.markdown(
            f"""
            <div class='user-msg'>
                <b>You:</b><br>
                {content}
            </div>
            """,
            unsafe_allow_html=True
        )

    else:

        st.markdown(
            f"""
            <div class='bot-msg'>
                <b>Assistant:</b><br>
                {content}
            </div>
            """,
            unsafe_allow_html=True
        )


# ============================================================
# 25. CHAT INPUT
# ============================================================

prompt = st.chat_input(
    "Ask a question from the PDF knowledge graph"
)


if prompt:

    st.session_state.messages.append(
        {
            "role": "user",
            "content": prompt
        }
    )

    try:

        driver = get_neo4j_driver()

        # Check whether any chunks exist
        with driver.session() as session:
            result = session.run(
                "MATCH (c:Chunk) RETURN count(c) AS total"
            )

            record = result.single()
            total_chunks = record["total"]

        if total_chunks == 0:

            answer = (
                "Please upload a PDF and click "
                "'Build Knowledge Graph' before asking questions."
            )

            retrieved_chunks = []

        else:

            answer, retrieved_chunks = graph_rag(
                driver,
                prompt
            )

        st.session_state.messages.append(
            {
                "role": "assistant",
                "content": answer
            }
        )

        # ----------------------------------------------------
        # SHOW RETRIEVED SOURCES
        # ----------------------------------------------------

        if retrieved_chunks:

            with st.expander(
                "🔎 View retrieved PDF context"
            ):

                for chunk in retrieved_chunks:

                    st.markdown(
                        f"**Document:** "
                        f"{chunk.get('document_name', 'Unknown')}"
                    )

                    st.markdown(
                        f"**Page:** "
                        f"{chunk.get('page', 'Unknown')}"
                    )

                    entities = chunk.get("entities", [])

                    if entities:
                        st.markdown(
                            f"**Entities:** "
                            f"{', '.join(entities)}"
                        )

                    st.markdown("**Text:**")
                    st.write(chunk.get("text", ""))

                    st.markdown("---")

        save_chat(
            st.session_state.messages
        )

    except Exception as error:

        error_message = f"❌ Error: {error}"

        st.session_state.messages.append(
            {
                "role": "assistant",
                "content": error_message
            }
        )

    st.rerun()
